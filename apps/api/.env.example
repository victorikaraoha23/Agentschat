# AgentsChat API — server-only configuration (never exposed to the browser).
# There are no required values: every setting has a safe default and the API
# starts with no .env file. Copy to .env only when real values exist, and
# never commit the copy — .env* files are ignored (root .gitignore).
# Start with: uv run uvicorn app.main:app --port 8000 --env-file .env
# Fill in both Supabase values below, or remove both entries to run without
# Supabase. Empty and whitespace-only values are invalid.

# Supabase project URL for the backend client (pairs with the key below).
# Optional — when unset, Supabase stays unconfigured and local development
# runs without it.
AGENTSCHAT_API_SUPABASE_URL=

# Privileged Supabase service-role key — SERVER-ONLY. Never use a NEXT_PUBLIC_*
# variable for this, never send it to the browser, never log it.
# Optional — must be set together with AGENTSCHAT_API_SUPABASE_URL, or neither.
AGENTSCHAT_API_SUPABASE_SERVICE_ROLE_KEY=

# Command that starts the Hermes CLI (the agent runtime), for example `hermes`
# on PATH or an absolute path to the installed command. Optional — when unset,
# Hermes stays unconfigured: agent runs report "unavailable" and nothing else
# changes. If this entry is present it must be non-empty; comment it out
# rather than leaving it blank.
AGENTSCHAT_API_HERMES_EXECUTABLE=

# Hard wall-clock limit in seconds for one agent run. The run is stopped and
# reported as timed out when it elapses.
AGENTSCHAT_API_HERMES_TIMEOUT_SECONDS=120

