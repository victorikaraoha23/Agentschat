# AgentsChat web application — client-visible configuration.
# NEXT_PUBLIC_* values are compiled into the browser bundle: NEVER put secrets here.

# Base URL of the FastAPI backend as seen from the browser.
# Optional — the application defaults to http://127.0.0.1:8000 when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project URL (public identifier, safe for the browser bundle).
# Optional — when unset (or the anon key is unset) the Supabase client is
# unavailable and the app runs without it.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (browser-safe by design; NOT a privileged key).
# Optional — never put the service-role key or any other secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
