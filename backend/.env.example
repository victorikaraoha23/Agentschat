# AgentsChat backend environment.
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets, and never log these values.

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=4

# --- Infrastructure ---------------------------------------------------------
# Blank means "not configured".
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Lemon Squeezy) ------------------------------------------------
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# --- Integrations -----------------------------------------------------------
RESEND_API_KEY=
SENTRY_DSN=
AXIOM_TOKEN=
SEARCH_API_KEY=
SEARCH_PROVIDER=brave

# --- Models -----------------------------------------------------------------
# No model ID is hard-coded in a code path; every one is resolved from here.
#
# Primary tiers (Anthropic).
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_MID=claude-sonnet-5
MODEL_PREMIUM=claude-sonnet-5
#
# Fallbacks (OpenAI).
# VERIFY-AT-BUILD: OpenAI model IDs change often. Verified 2026-09-20 against
# https://developers.openai.com/api/docs/models — re-check before trusting these.
# GPT-5.6 has no dated snapshots; the IDs below are the default snapshots.
MODEL_CHEAP_FALLBACK=gpt-5.6-luna
MODEL_MID_FALLBACK=gpt-5.6-terra
MODEL_PREMIUM_FALLBACK=gpt-5.6-sol
#
# Comma-separated allow-list of every model ID the gateway may resolve.
ALLOWED_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
